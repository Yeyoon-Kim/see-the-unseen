# Frontend, used by Vite/Vercel
# Set this to the deployed Express API URL if the API is hosted separately.
# Leave empty only when the frontend and API share the same origin under /api.
VITE_API_URL=

# Local-only Vite dev proxy target. Example: http://127.0.0.1:4000
VITE_DEV_API_TARGET=

# Supabase Auth / sync. If these are empty, the app uses local-only demo auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend, used by the Express API
DATABASE_URL="file:./dev.db"
PORT=4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
