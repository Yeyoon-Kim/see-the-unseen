# Deployed backend URL. Use this on Vercel when the Express API is hosted separately.
VITE_API_URL=

# Local-only Vite dev proxy target. Example: http://127.0.0.1:4000
VITE_DEV_API_TARGET=

# Supabase Auth / sync. If empty, the app falls back to local-only demo auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
